{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyDict",
  "version": "1.0.0",
  "identifier": "com.hydict.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HyDict Desktop",
        "label": "main",
        "width": 860,
        "height": 640,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": true,
        "shadow": true,
        "skipTaskbar": false
      },
      {
        "title": "HyDict Quick Lookup",
        "label": "hud",
        "url": "index.html#hud",
        "width": 480,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "dictionary.db"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
